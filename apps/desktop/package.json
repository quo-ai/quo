{
  "name": "quo-desktop",
  "productName": "Quo",
  "version": "1.7.1",
  "private": true,
  "description": "Quo, private AI that runs on your computer and works offline.",
  "author": {
    "name": "Astra Labs Ltd",
    "email": "hello@quo.computer"
  },
  "license": "Apache-2.0",
  "homepage": "https://quo.computer",
  "repository": {
    "type": "git",
    "url": "https://github.com/quo-ai/quo.git"
  },
  "main": "src/main.js",
  "desktopName": "quo-desktop.desktop",
  "scripts": {
    "dev": "electron .",
    "build:web": "npm --prefix ../web run build",
    "dist": "electron-builder --publish never",
    "smoke": "electron . --smoke",
    "fetch:engine": "node scripts/fetch-engine.js",
    "check:engine": "node scripts/check-engine.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.323",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
