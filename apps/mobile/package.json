{
  "name": "quo",
  "main": "expo-router/entry",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "cross-env EXPO_NO_TELEMETRY=1 expo start",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "sandbox": "bash scripts/android-sandbox.sh",
    "ios:release": "bash scripts/build-ios-release.sh",
    "ios:release:upload": "bash scripts/build-ios-release.sh --upload",
    "postinstall": "node scripts/apply-native-patches.js",
    "fetch:starter-model": "node scripts/fetch-starter-model.js",
    "eas-build-post-install": "node scripts/fetch-starter-model.js"
  },
  "dependencies": {
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@kesha-antonov/react-native-background-downloader": "^4.6.3",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^24.1.1",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/crashlytics": "^24.1.1",
    "@react-native-firebase/remote-config": "^24.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "buffer": "^6.0.3",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "llama.rn": "0.12.9",
    "lucide-react-native": "^1.23.0",
    "markdown-it": "^14.1.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-iap": "^14.7.20",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "whisper.rn": "^0.7.4"
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "$markdown-it"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  }
}
