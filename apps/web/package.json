{
  "name": "quo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx server/serve.ts",
    "test:interop": "vitest run --config vitest.interop.config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@huggingface/transformers": "^4.3.1",
    "@wllama/wllama": "^3.8.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
