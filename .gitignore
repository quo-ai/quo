# Shared rules; each app has its own .gitignore for the rest.
node_modules/
dist/
*.tsbuildinfo
__pycache__/
# Secrets and credentials are never committed. scripts/check-secrets.js enforces this in CI,
# and GitHub's secret scanning and push protection are on for the repository.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
!apps/mobile/android/app/debug.keystore
*.mobileprovision
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
!*.pub
.netrc
.git-credentials
.aws/
.ssh/
.vercel/
google-services.json
GoogleService-Info.plist
signing.properties
service-account*.json
credentials.json
secrets.json
secrets.y*ml
*.tfstate
*.tfstate.*
*.log

# Editors, OS and local tooling
.DS_Store
.vscode/
.idea/
.claude/
.agents/
skills-lock.json
